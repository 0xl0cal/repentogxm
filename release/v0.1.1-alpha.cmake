# repentogxm v0.1.1-alpha: the complete CMake option set of the released
# eboot.bin, copied from the release build's cache (every ISAAC_VITA_* BOOL and
# STRING entry plus the guest base). Paths are per machine and are given on
# the command line. Reproduce the release build from a fresh build directory
# (softfp VitaSDK, Ninja, Python 3.10+, requirements.txt installed):
#
#   export VITASDK=<vitasdk-softfp>; export PATH="$VITASDK/bin:$PATH"
#   GUEST_LEAF_INLINE=1 GUEST_FLOOR_THUNK_FASTPATH=1 \
#     python tools/build_vita.py --pe <isaac-ng.exe.unpacked.exe> \
#       --vitasdk "$VITASDK" --generated-dir <generated> --generate-only
#   cmake -S recomp/vita -B <build> -G Ninja -C release/v0.1.1-alpha.cmake \
#     -DCMAKE_TOOLCHAIN_FILE="$VITASDK/share/vita.toolchain.cmake" \
#     -DISAAC_PE_PATH=<isaac-ng.exe.unpacked.exe> \
#     -DISAAC_GENERATED_DIR=<generated> \
#     -DISAAC_LUA53_SOURCE_DIR=<pristine lua-5.3.3 source tree>
#   ninja -C <build> eboot.bin the-binding-of-isaac-repentance.vpk
#
# The two GUEST_* variables select the generation-time switches this release's
# corpus was produced with (tiny-leaf inlining and the floor thunk fast path);
# a corpus generated without them does not match these options. A -D on the
# command line overrides an entry of this file (release candidates override
# ISAAC_VITA_GUEST_LINK_ID). SOURCE_DATE_EPOCH fixes the timestamps of the VPK
# members (2026-09-07 00:00:00 UTC).

