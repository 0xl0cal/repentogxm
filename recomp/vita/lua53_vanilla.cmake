foreach(ISAAC_LUA53_RECORD IN LISTS ISAAC_LUA53_SOURCE_RECORDS)
  string(REPLACE "|" ";" ISAAC_LUA53_FIELDS "${ISAAC_LUA53_RECORD}")
  list(GET ISAAC_LUA53_FIELDS 0 ISAAC_LUA53_NAME)
  list(GET ISAAC_LUA53_FIELDS 1 ISAAC_LUA53_EXPECTED_SHA)
  set(ISAAC_LUA53_FILE "${ISAAC_LUA53_SOURCE_DIR}/src/${ISAAC_LUA53_NAME}")
  if(NOT EXISTS "${ISAAC_LUA53_FILE}" OR IS_DIRECTORY "${ISAAC_LUA53_FILE}")
    message(FATAL_ERROR "Lua 5.3.3 source is missing: ${ISAAC_LUA53_NAME}")
  endif()
  file(SHA256 "${ISAAC_LUA53_FILE}" ISAAC_LUA53_ACTUAL_SHA)
  if(NOT ISAAC_LUA53_ACTUAL_SHA STREQUAL ISAAC_LUA53_EXPECTED_SHA)
    message(FATAL_ERROR
      "Lua 5.3.3 source hash mismatch for ${ISAAC_LUA53_NAME}: "
      "${ISAAC_LUA53_ACTUAL_SHA}")
  endif()
  if(ISAAC_LUA53_NAME MATCHES "\\.c$")
    list(APPEND ISAAC_LUA53_C_SOURCES "${ISAAC_LUA53_FILE}")
  endif()
endforeach()
