 				&gxm_depth_stencil_surface);
+			ISAAC_SCENE_TIME_END_BEGIN_SCENE();
 #ifdef HAVE_ISAAC_GXM_STATE_SHADOW
 			isaacGxmStateBeginScene(gxm_context, r);
 #endif
