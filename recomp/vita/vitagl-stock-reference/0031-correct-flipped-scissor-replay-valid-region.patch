diff --git a/source/gxm.c b/source/gxm.c
--- a/source/gxm.c
+++ b/source/gxm.c
@@ -1135,6 +1135,14 @@ void scene_reset(void) {
 #ifndef DISABLE_TILE_CLIPPER
 		if (scissor_test_state) {
 			int clip_x_min = region.x, clip_y_min = region.y, clip_x_max = region.x + region.w - 1, clip_y_max = region.y + region.h - 1;
+#ifndef HAVE_UNFLIPPED_FBOS
+			if (!is_rendering_display) {
+				/* Match update_scissor_test before the existing valid-region clamp. */
+				int y = region.gl_y > 0 ? region.gl_y : 0;
+				clip_y_min = y;
+				clip_y_max = y + region.h - 1;
+			}
+#endif
 			isaacFboRegionClampClip(&clip_x_min, &clip_y_min, &clip_x_max, &clip_y_max);
 			sceGxmSetRegionClip(gxm_context, SCE_GXM_REGION_CLIP_OUTSIDE, clip_x_min, clip_y_min, clip_x_max, clip_y_max);
 		}
