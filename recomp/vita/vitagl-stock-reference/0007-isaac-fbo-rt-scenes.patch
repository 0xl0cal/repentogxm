+#ifdef HAVE_ISAAC_FBO_RT_SCENES
+/* Isaac (0007-isaac-fbo-rt-scenes.patch): scenes per frame for the render
+ * targets that scene_reset creates lazily for framebuffer objects.  Stock
+ * vitaGL sizes them for one scene, so when several scenes of a frame run on
+ * the same target the sceGxmEndScene of scene k waits until scene k-1 has
+ * finished on the GPU (measured on the device with the Isaac GL time
+ * profile: the glClear stall is that EndScene wait).  The consumer sets
+ * 1..MAX_SCENES_PER_FRAME once at start-up through
+ * vglIsaacSetupFboRenderTargetScenes, which it declares itself (not in
+ * vitaGL.h, whose whole-file hash must stay stable); a failed
+ * sceGxmCreateRenderTarget for that count falls back to the stock single
+ * slot at the creation site so a framebuffer never stays without a target.
+ * Upstream later added the same knob (f142f14, vglSetupRenderTargetScenesNum). */
+static uint8_t gxm_fbo_rt_size = 1; // Number of scenes per frame to use for fbo rendertargets
+#define ISAAC_FBO_RT_SCENES() gxm_fbo_rt_size
+#else
+#define ISAAC_FBO_RT_SCENES() 1
+#endif
 #ifdef HAVE_PTHREAD
 pthread_t gc_thread;
 #else
@@ -790,7 +808,14 @@ void scene_reset(void) {
