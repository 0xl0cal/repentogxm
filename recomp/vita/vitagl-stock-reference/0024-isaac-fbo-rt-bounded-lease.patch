diff --git a/source/gxm.c b/source/gxm.c
--- a/source/gxm.c
+++ b/source/gxm.c
@@ -587,6 +587,20 @@
 		sceDisplayWaitVblankStartMulti(vsync_interval);
 }
 
+#if defined(HAVE_ISAAC_FBO_RT_REUSE_LEASE) && HAVE_ISAAC_FBO_RT_REUSE_LEASE
+/* This is called only after Finish. Take rechecks this retirement's actual
+ * original Collect witness; detach before the driver, never before deadline. */
+void vglIsaacFboRtDrainAfterFinish(void) {
+	SceGxmRenderTarget *rt = (SceGxmRenderTarget *)isaacFboRtRecoveryTake();
+	if (rt) {
+#ifdef HAVE_ISAAC_NATIVE_RESOURCE_PROFILE
+		isaacNativeResourceRetireRT(rt);
+#endif
+		sceGxmDestroyRenderTarget(rt);
+	}
+}
+#endif
+
 // Garbage collector
 #if defined(HAVE_PTHREAD) && !defined(HAVE_SINGLE_THREADED_GC)
 void garbage_collector(void *arg) {
@@ -1004,7 +1018,21 @@
 						msaa_mode == SCE_GXM_MULTISAMPLE_NONE);
 #endif
 #ifdef HAVE_ISAAC_FBO_RT_SCENES
+#if defined(HAVE_ISAAC_FBO_RT_REUSE_LEASE) && HAVE_ISAAC_FBO_RT_REUSE_LEASE
+				if (r && isaacFboRtHasSpare()) {
+					isaacFboRtRecoveryBegin();
+					/* Immature pressure only revokes; no added Finish or GC.
+					 * Take still rechecks after a possibly reentrant Finish. */
+					if (isaacFboRtHasMatureSpare()) {
+						sceGxmFinish(gxm_context);
+						vglIsaacFboRtDrainAfterFinish();
+					}
+					isaacFboRtRecoveryEnd();
+				}
+#endif
+				/* Preserve the original requested-eight then fallback-one order.
+				 * The lease does not add another eight-scene creation attempt. */
 				if (r && gxm_fbo_rt_size != 1) {
 					// Fail closed: a target sized for several scenes needs more driver memory; fall back to the stock single slot rather than leave the framebuffer without a rendertarget
 					active_write_fb->target = NULL;
 					r = setup_render_target(&active_write_fb->target, active_write_fb->width, active_write_fb->height, 1);
