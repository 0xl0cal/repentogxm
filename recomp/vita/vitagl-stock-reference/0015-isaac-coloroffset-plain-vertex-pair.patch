+				if (isaac_neutral_staging == ISAAC_COLOROFFSET_STAGING_PLAIN) {
+					isaac_probe_fragment = isaac_plain_vertex_pair_select(p, &isaac_pair_vertex);
+					if (!isaac_probe_fragment)
+						isaac_probe_fragment = isaac_coloroffset_plain_select(p);
+				}
