+	 * A dirty upload below already installs its new buffer. */
+	if ((isaac_pair_vertex || isaac_pair_was_bound) && !dirty_shader_vert_unifs)
+		vglRestoreVertexUniformBuffer();
+	isaac_pair_was_bound = isaac_pair_vertex ? GL_TRUE : GL_FALSE;
 
