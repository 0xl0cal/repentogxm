+		if (scissor_test_state) {
+			int clip_x_min = region.x, clip_y_min = region.y, clip_x_max = region.x + region.w - 1, clip_y_max = region.y + region.h - 1;
+			isaacFboRegionClampClip(&clip_x_min, &clip_y_min, &clip_x_max, &clip_y_max);
+			sceGxmSetRegionClip(gxm_context, SCE_GXM_REGION_CLIP_OUTSIDE, clip_x_min, clip_y_min, clip_x_max, clip_y_max);
