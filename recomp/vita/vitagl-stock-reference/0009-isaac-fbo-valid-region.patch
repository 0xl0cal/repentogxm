+#ifdef HAVE_ISAAC_FBO_VALID_REGION
+// Isaac 0009: read by isaacFboRegionNoteViewport above (defined here, after the stock flag it reads)
+static GLboolean isaac_fbo_region_scene_reset_pending(void) {
+	return needs_scene_reset;
+}
+#endif
 
