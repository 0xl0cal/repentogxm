new file mode 100644
index 0000000..d2c3f53
--- /dev/null
+++ b/source/isaac_gxm_state_shadow.c
@@ -0,0 +1,64 @@
+#define ISAAC_GXM_STATE_SHADOW_IMPLEMENTATION
+#include "shared.h"
+#ifdef HAVE_ISAAC_GXM_STATE_SHADOW
+#include "isaac_gxm_state_policy.h"
+
+_Static_assert(sizeof(SceGxmTexture) == ISAAC_GXM_STATE_TEXTURE_BYTES,
+	"Isaac texture state shadow requires the complete 16-byte descriptor");
+
+static isaac_gxm_state_policy isaac_state_policy;
+
+void isaacGxmStateBeginScene(SceGxmContext *context, int result) {
+	isaac_gxm_state_begin_scene(
+		&isaac_state_policy, (uintptr_t)context, result == 0);
+}
+
+void isaacGxmStateEndScene(SceGxmContext *context) {
+	isaac_gxm_state_invalidate(&isaac_state_policy, (uintptr_t)context);
+}
+
+void isaacGxmStateInvalidate(SceGxmContext *context) {
+	isaac_gxm_state_invalidate_values(
+		&isaac_state_policy, (uintptr_t)context);
+}
+
+void isaacGxmSetVertexProgram(
+		SceGxmContext *context, const SceGxmVertexProgram *program) {
+	if (isaac_gxm_state_vertex_program(
+			&isaac_state_policy, (uintptr_t)context, (uintptr_t)program))
+		return;
+	sceGxmSetVertexProgram(context, program);
+}
+
+void isaacGxmSetFragmentProgram(
+		SceGxmContext *context, const SceGxmFragmentProgram *program) {
+	if (isaac_gxm_state_fragment_program(
+			&isaac_state_policy, (uintptr_t)context, (uintptr_t)program))
+		return;
+	sceGxmSetFragmentProgram(context, program);
+}
+
+void isaacGxmSetFragmentTexture(
+		SceGxmContext *context, unsigned int unit,
+		const SceGxmTexture *texture) {
+	if (isaac_gxm_state_fragment_texture(
+			&isaac_state_policy, (uintptr_t)context, unit, texture))
+		return;
+	sceGxmSetFragmentTexture(context, unit, texture);
+}
+
+void isaacGxmStateSnapshot(vglIsaacGpuDrawStats *stats) {
+	stats->vertex_set_hits =
+		isaac_state_policy.counters.vertex_program_hits;
+	stats->vertex_set_misses =
+		isaac_state_policy.counters.vertex_program_misses;
+	stats->fragment_set_hits =
+		isaac_state_policy.counters.fragment_program_hits;
+	stats->fragment_set_misses =
+		isaac_state_policy.counters.fragment_program_misses;
+	stats->texture_set_hits =
+		isaac_state_policy.counters.fragment_texture_hits;
+	stats->texture_set_misses =
+		isaac_state_policy.counters.fragment_texture_misses;
+}
+#endif
