+static inline void isaac_note_vertex_copy(uint32_t vertices,
+		uint32_t stride) {
+	ISAAC_GPU_DRAW_ADD(vertex_bytes,
+		(uint32_t)((uint64_t)vertices * stride));
+}
+
+static inline void isaac_capture_attribute_key(
+		isaac_vitagl_attribute_key *out,
+		const SceGxmVertexAttribute *attribute) {
+	out->stream_index = attribute->streamIndex;
+	out->offset = attribute->offset;
+	out->format = attribute->format;
+	out->component_count = attribute->componentCount;
+	out->reg_index = attribute->regIndex;
+}
+
+static inline void isaac_capture_stream_key(
+		isaac_vitagl_stream_key *out,
+		const SceGxmVertexStream *stream) {
+	out->stride = stream->stride;
+	out->index_source = stream->indexSource;
+}
+
+static GLboolean isaac_try_coalesce_single_stream(
+		const SceGxmVertexAttribute *attributes,
+		const SceGxmVertexStream *streams,
+		const uintptr_t *stream_bases, uint32_t attribute_count,
+		SceGxmVertexAttribute **draw_attributes,
+		SceGxmVertexStream **draw_streams) {
+	enum isaac_vitagl_coalesce_result result;
+	uint32_t index;
+
+	ISAAC_GPU_DRAW_COUNT(coalesce_attempts);
+	for (index = 0; index < attribute_count &&
+			index < ISAAC_VITAGL_MAX_VERTEX_ATTRIBUTES; ++index) {
+		isaac_capture_attribute_key(
+			&isaac_attribute_key_scratch[index], &attributes[index]);
+		isaac_capture_stream_key(
+			&isaac_stream_key_scratch[index], &streams[index]);
+	}
+	result = isaac_vitagl_single_stream_policy(
+		isaac_attribute_key_scratch, isaac_stream_key_scratch,
+		stream_bases, attribute_count);
+	if (result != ISAAC_VITAGL_COALESCE_OK) {
+		switch (result) {
+		case ISAAC_VITAGL_COALESCE_REJECT_COUNT:
+			ISAAC_GPU_DRAW_COUNT(coalesce_reject_count);
+			break;
+		case ISAAC_VITAGL_COALESCE_REJECT_STREAM_INDEX:
+			ISAAC_GPU_DRAW_COUNT(coalesce_reject_stream_index);
+			break;
+		case ISAAC_VITAGL_COALESCE_REJECT_BASE:
+			ISAAC_GPU_DRAW_COUNT(coalesce_reject_base);
+			break;
+		case ISAAC_VITAGL_COALESCE_REJECT_DESCRIPTOR:
+			ISAAC_GPU_DRAW_COUNT(coalesce_reject_descriptor);
+			break;
+		default:
+			break;
+		}
+		return GL_FALSE;
+	}
+
+	for (index = 0; index < attribute_count; ++index) {
+		isaac_coalesced_attributes[index] = attributes[index];
+		isaac_coalesced_attributes[index].streamIndex = 0;
+	}
+	isaac_coalesced_stream = streams[0];
+	*draw_attributes = isaac_coalesced_attributes;
+	*draw_streams = &isaac_coalesced_stream;
+	ISAAC_GPU_DRAW_COUNT(coalesce_hits);
+	ISAAC_GPU_DRAW_ADD(stream_slots_before, attribute_count);
+	ISAAC_GPU_DRAW_COUNT(stream_slots_after);
+	return GL_TRUE;
+}
+
+static GLboolean isaac_vertex_cache_key_matches(
+		const isaac_vertex_program_cache_entry *entry,
+		SceGxmShaderPatcherId shader_id,
+		const SceGxmVertexAttribute *attributes,
+		uint32_t attribute_count, const SceGxmVertexStream *streams,
+		uint32_t stream_count) {
+	uint32_t index;
+
+	if (attribute_count > ISAAC_VITAGL_MAX_VERTEX_ATTRIBUTES ||
+			stream_count > ISAAC_VITAGL_MAX_VERTEX_ATTRIBUTES ||
+			entry->shader_id != shader_id)
+		return GL_FALSE;
+	for (index = 0; index < attribute_count; ++index)
+		isaac_capture_attribute_key(
+			&isaac_attribute_key_scratch[index], &attributes[index]);
+	for (index = 0; index < stream_count; ++index)
+		isaac_capture_stream_key(
+			&isaac_stream_key_scratch[index], &streams[index]);
+	return isaac_vitagl_layout_key_equal(
+		entry->attributes, entry->attribute_count,
+		entry->streams, entry->stream_count,
+		isaac_attribute_key_scratch, attribute_count,
+		isaac_stream_key_scratch, stream_count);
+}
+
+static void isaac_patch_vertex_program_cached(program *p,
+		SceGxmShaderPatcherId shader_id,
+		const SceGxmVertexAttribute *attributes,
+		uint32_t attribute_count, const SceGxmVertexStream *streams,
+		uint32_t stream_count) {
+	isaac_vertex_program_cache_entry *entry = p->isaac_vertex_cache;
+	int result;
+	uint32_t index;
+
+	ISAAC_GPU_DRAW_COUNT(vertex_program_requests);
+	while (entry) {
+		if (isaac_vertex_cache_key_matches(
+				entry, shader_id, attributes, attribute_count,
+				streams, stream_count)) {
+			p->vprog = entry->vertex_program;
+			ISAAC_GPU_DRAW_COUNT(vertex_program_hits);
+			return;
+		}
+		entry = entry->next;
+	}
+
+	ISAAC_GPU_DRAW_COUNT(vertex_program_misses);
+	ISAAC_GXM_SHADER_STATE_INVALIDATE();
+	result = sceGxmShaderPatcherCreateVertexProgram(
+		gxm_shader_patcher, shader_id, attributes, attribute_count,
+		streams, stream_count, &p->vprog);
+	if (result) {
+		ISAAC_GPU_DRAW_COUNT(vertex_program_create_failures);
+#ifdef LOG_ERRORS
+		vgl_log("Vertex shader patching failed (%s) on shader 0x%X with %d attributes and %d streams.\n",
+			get_gxm_error_literal(result), shader_id,
+			attribute_count, stream_count);
+#endif
+		return;
+	}
+
+	if (p->isaac_vertex_cache_count >=
+			ISAAC_VITAGL_VERTEX_CACHE_CAPACITY) {
+		ISAAC_GPU_DRAW_COUNT(vertex_program_full_fallbacks);
+		return;
+	}
+	entry = vglMalloc(sizeof(*entry));
+	if (!entry) {
+		ISAAC_GPU_DRAW_COUNT(vertex_program_store_failures);
+		return;
+	}
+	entry->next = p->isaac_vertex_cache;
+	entry->shader_id = shader_id;
+	entry->attribute_count = attribute_count;
+	entry->stream_count = stream_count;
+	for (index = 0; index < attribute_count; ++index)
+		isaac_capture_attribute_key(
+			&entry->attributes[index], &attributes[index]);
+	for (index = 0; index < stream_count; ++index)
+		isaac_capture_stream_key(&entry->streams[index], &streams[index]);
+	entry->vertex_program = p->vprog;
+	p->isaac_vertex_cache = entry;
+	p->isaac_vertex_cache_count++;
+	ISAAC_GPU_DRAW_COUNT(vertex_program_stores);
+}
+
+/* The caller must finish the GXM context before releasing entries which may
+ * still be referenced by submitted draws. */
+static void isaac_release_vertex_program_cache(program *p) {
+	isaac_vertex_program_cache_entry *entry = p->isaac_vertex_cache;
+	ISAAC_GXM_SHADER_STATE_INVALIDATE();
+	while (entry) {
+		isaac_vertex_program_cache_entry *next = entry->next;
+		sceGxmShaderPatcherReleaseVertexProgram(
+			gxm_shader_patcher, entry->vertex_program);
+		ISAAC_GPU_DRAW_COUNT(vertex_program_releases);
+		vgl_free(entry);
+		entry = next;
+	}
+	p->isaac_vertex_cache = NULL;
+	p->isaac_vertex_cache_count = 0;
+	p->vprog = NULL;
+}
