+	(isaac_gpu_draw_stats.field += (value))
+#define ISAAC_GPU_DRAW_MAX(field, value) do { \
+	if ((value) > isaac_gpu_draw_stats.field) \
+		isaac_gpu_draw_stats.field = (value); \
+} while (0)
+#else
+#define ISAAC_GPU_DRAW_COUNT(field) ((void)0)
