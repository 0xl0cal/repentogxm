 }
diff --git a/source/gxm.c b/source/gxm.c
--- a/source/gxm.c
+++ b/source/gxm.c
@@ -23,1 +23,15 @@
 #include "shared.h"
+#if defined(HAVE_ISAAC_GL_TIME_SDK_SPARSE) && HAVE_ISAAC_GL_TIME_SDK_SPARSE
+#include "isaac_sdk_sparse_profile_internal.h"
+#define ISAAC_SDK_SCENE_CLOCK() isaacSdkSparseClock()
+/* Count actual attempts, including the optional valid-region retry. The
+ * existing scene bracket may enclose both attempts; it is not one SDK call. */
+#define sceGxmBeginScene(...) \
+	(++isaac_sdk_sparse.begin_calls, sceGxmBeginScene(__VA_ARGS__))
+#define sceGxmEndScene(...) \
+	(++isaac_sdk_sparse.end_calls, sceGxmEndScene(__VA_ARGS__))
+#else
+#define ISAAC_SDK_SCENE_CLOCK() sceKernelGetProcessTimeWide()
+#define ISAAC_SDK_BEGIN(name) ((void)0)
+#define ISAAC_SDK_END(kind, name) ((void)0)
+#endif
@@ -65,1 +79,1 @@
-#define ISAAC_SCENE_TIME_BEGIN() uint64_t isaac_scene_t0 = sceKernelGetProcessTimeWide()
+#define ISAAC_SCENE_TIME_BEGIN() uint64_t isaac_scene_t0 = ISAAC_SDK_SCENE_CLOCK()
@@ -68,1 +82,1 @@
-		uint32_t isaac_scene_dt = (uint32_t)(sceKernelGetProcessTimeWide() - isaac_scene_t0); \
+		uint32_t isaac_scene_dt = (uint32_t)(ISAAC_SDK_SCENE_CLOCK() - isaac_scene_t0); \
@@ -76,1 +90,1 @@
-		uint32_t isaac_scene_dt = (uint32_t)(sceKernelGetProcessTimeWide() - isaac_scene_t0); \
+		uint32_t isaac_scene_dt = (uint32_t)(ISAAC_SDK_SCENE_CLOCK() - isaac_scene_t0); \
@@ -1154,1 +1168,3 @@ void vglSwapBuffers(GLboolean has_commondialog) {
+		ISAAC_SDK_BEGIN(isaac_sdk_queue_t0);
 		sceGxmDisplayQueueAddEntry(gxm_sync_objects[gxm_front_buffer_index], gxm_sync_objects[gxm_back_buffer_index], &queue_cb_data);
+		ISAAC_SDK_END(ISAAC_SDK_QUEUE, isaac_sdk_queue_t0);
