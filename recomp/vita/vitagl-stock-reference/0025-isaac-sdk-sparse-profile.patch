@@ -676,8 +684,12 @@ void glClear(GLbitfield mask) {
+	ISAAC_SDK_BEGIN(isaac_sdk_vertex_t0);
 	sceGxmReserveVertexDefaultUniformBuffer(gxm_context, &vbuffer);
+	ISAAC_SDK_END(ISAAC_SDK_CLEAR_VERTEX, isaac_sdk_vertex_t0);
 	sceGxmSetUniformDataF(vbuffer, clear_position, 0, 4, &clear_vertices->x);
