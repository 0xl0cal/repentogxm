+
+static uint8_t isaac_coloroffset_source_exact[MAX_CUSTOM_SHADERS];
+static uint8_t isaac_coloroffset_compile_exact[MAX_CUSTOM_SHADERS];
+static uint32_t isaac_coloroffset_source_generation[MAX_CUSTOM_SHADERS];
+static uint32_t isaac_coloroffset_compiled_generation[MAX_CUSTOM_SHADERS];
+static vglIsaacColorOffsetStats isaac_coloroffset_stats = {
+	.abi_version = 1,
+	.enabled = 1,
+};
+#ifdef HAVE_ISAAC_PHASE_PROFILE
+#define ISAAC_COLOROFFSET_COUNT(field) (isaac_coloroffset_stats.field++)
+#define ISAAC_COLOROFFSET_ADD(field, value) \
+	(isaac_coloroffset_stats.field += (value))
+#else
+#define ISAAC_COLOROFFSET_COUNT(field) ((void)0)
+#define ISAAC_COLOROFFSET_ADD(field, value) ((void)0)
+#endif
+
+static uint32_t isaac_coloroffset_fnv1a(const void *data, uint32_t size) {
+	const uint8_t *bytes = (const uint8_t *)data;
+	uint32_t hash = 0x811c9dc5u;
+	uint32_t index;
+	for (index = 0; index < size; ++index) {
+		hash ^= bytes[index];
+		hash *= 0x01000193u;
+	}
+	return hash;
+}
+
+static int32_t isaac_coloroffset_shader_index(const shader *s) {
+	uintptr_t address;
+	uintptr_t base;
+	uintptr_t offset;
+	if (!s)
+		return -1;
+	address = (uintptr_t)s;
+	base = (uintptr_t)&shaders[0];
+	if (address < base || address >= (uintptr_t)&shaders[MAX_CUSTOM_SHADERS])
+		return -1;
+	offset = address - base;
+	if (offset % sizeof(shader))
+		return -1;
+	return (int32_t)(offset / sizeof(shader));
+}
+
+static void isaac_coloroffset_advance_shader_generation(uint32_t index) {
+	if (index >= MAX_CUSTOM_SHADERS)
+		return;
+	isaac_coloroffset_source_generation[index] =
+		isaac_coloroffset_next_generation(
+			isaac_coloroffset_source_generation[index]);
+}
+
+static GLboolean isaac_coloroffset_fragment_shader_is_exact(const shader *s) {
+	return s && s->prog &&
+		sceGxmProgramGetSize(s->prog) == ISAAC_COLOROFFSET_FRAGMENT_GXP_SIZE &&
+		isaac_coloroffset_fnv1a(
+			s->prog, ISAAC_COLOROFFSET_FRAGMENT_GXP_SIZE) ==
+			ISAAC_COLOROFFSET_FRAGMENT_GXP_FNV1A &&
+		isaac_coloroffset_fnv1a(s->prog, 512u) ==
+			ISAAC_COLOROFFSET_FRAGMENT_GXP_FIRST512_FNV1A;
+}
+
+void vglIsaacMarkColorOffsetShader(
+		uint32_t handle, uint32_t source_fnv1a,
+		uint32_t source_first512_fnv1a, uint32_t source_size) {
+	shader *s;
+	uint32_t index;
+	if (!handle || handle > MAX_CUSTOM_SHADERS)
+		return;
+	index = handle - 1u;
+	s = &shaders[index];
+	isaac_coloroffset_source_exact[index] = 0;
+	isaac_coloroffset_compile_exact[index] = 0;
+	isaac_coloroffset_compiled_generation[index] = 0;
+	if (!isaac_coloroffset_source_generation[index] ||
+			!s->valid || !s->is_glsl || s->type != GL_FRAGMENT_SHADER ||
+			!s->source || source_size != ISAAC_COLOROFFSET_SOURCE_SIZE ||
+			source_fnv1a != ISAAC_COLOROFFSET_SOURCE_FNV1A ||
+			source_first512_fnv1a !=
+				ISAAC_COLOROFFSET_SOURCE_FIRST512_FNV1A ||
+			s->size != source_size ||
+			isaac_coloroffset_fnv1a(s->source, s->size) != source_fnv1a ||
+			isaac_coloroffset_fnv1a(s->source, 512u) !=
+				source_first512_fnv1a) {
+		ISAAC_COLOROFFSET_COUNT(source_mark_rejected);
+		return;
+	}
+	isaac_coloroffset_source_exact[index] = 1;
+	ISAAC_COLOROFFSET_COUNT(source_selected);
+}
+
+static void isaac_coloroffset_note_compile(shader *s) {
+	int32_t index = isaac_coloroffset_shader_index(s);
+	GLboolean binary_exact;
+	if (index < 0)
+		return;
+	isaac_coloroffset_compile_exact[index] = 0;
+	isaac_coloroffset_compiled_generation[index] = 0;
+	isaac_coloroffset_advance_shader_generation((uint32_t)index);
+	if (!isaac_coloroffset_source_exact[index])
+		return;
+	binary_exact =
+		isaac_coloroffset_source_generation[index] &&
+		isaac_coloroffset_fragment_shader_is_exact(s);
+	isaac_coloroffset_compile_exact[index] = binary_exact ? 1 : 0;
+	isaac_coloroffset_compiled_generation[index] = binary_exact ?
+		isaac_coloroffset_source_generation[index] : 0u;
+	if (binary_exact)
+		ISAAC_COLOROFFSET_COUNT(compile_successes);
+	else
+		ISAAC_COLOROFFSET_COUNT(compile_failures);
+}
+
+static GLboolean isaac_coloroffset_vertex_shader_is_exact(const shader *s) {
+	static const char *const names[ISAAC_COLOROFFSET_ATTRIBUTE_COUNT] = {
+		"Position", "Color", "TexCoord", "ColorizeIn", "ColorOffsetIn",
+		"TextureSize", "PixelationAmount", "ClipPlane"
+	};
+	uint32_t index;
+	const SceGxmProgramParameter *transform;
+	if (!s || !s->prog ||
+			sceGxmProgramGetSize(s->prog) != ISAAC_COLOROFFSET_VERTEX_GXP_SIZE ||
+			isaac_coloroffset_fnv1a(s->prog, ISAAC_COLOROFFSET_VERTEX_GXP_SIZE) !=
+				ISAAC_COLOROFFSET_VERTEX_GXP_FNV1A ||
+			isaac_coloroffset_fnv1a(s->prog, 512u) !=
+				ISAAC_COLOROFFSET_VERTEX_GXP_FIRST512_FNV1A ||
+			sceGxmProgramGetParameterCount(s->prog) != 9u)
+		return GL_FALSE;
+	for (index = 0; index < ISAAC_COLOROFFSET_ATTRIBUTE_COUNT; ++index) {
+		const SceGxmProgramParameter *param =
+			sceGxmProgramFindParameterByName(s->prog, names[index]);
+		if (!param ||
+				sceGxmProgramParameterGetCategory(param) !=
+					SCE_GXM_PARAMETER_CATEGORY_ATTRIBUTE ||
+				sceGxmProgramParameterGetResourceIndex(param) != index * 4u ||
+				sceGxmProgramParameterGetComponentCount(param) != 4u ||
+				sceGxmProgramParameterGetArraySize(param) != 1u)
+			return GL_FALSE;
+	}
+	transform = sceGxmProgramFindParameterByName(s->prog, "Transform");
+	return transform &&
+		sceGxmProgramParameterGetCategory(transform) ==
+			SCE_GXM_PARAMETER_CATEGORY_UNIFORM &&
+		sceGxmProgramParameterGetResourceIndex(transform) == 0u &&
+		sceGxmProgramParameterGetComponentCount(transform) == 4u &&
+		sceGxmProgramParameterGetArraySize(transform) == 4u &&
+		sceGxmProgramParameterGetContainerIndex(transform) == 14u;
+}
+
+static GLboolean isaac_coloroffset_fragment_program_is_exact(
+		const program *p) {
+	const SceGxmProgramParameter *texture0;
+	int32_t shader_index;
+	int32_t vertex_index;
+	if (!p || p->status != PROG_LINKED || !p->fshader || !p->fshader->prog ||
+			!p->vshader || !p->vshader->prog)
+		return GL_FALSE;
+	shader_index = isaac_coloroffset_shader_index(p->fshader);
+	vertex_index = isaac_coloroffset_shader_index(p->vshader);
+	if (shader_index < 0 || !isaac_coloroffset_source_exact[shader_index] ||
+			!isaac_coloroffset_compile_exact[shader_index] ||
+			!isaac_coloroffset_source_generation[shader_index] ||
+			isaac_coloroffset_compiled_generation[shader_index] !=
+				isaac_coloroffset_source_generation[shader_index] ||
+			p->isaac_coloroffset_link_source_generation !=
+				isaac_coloroffset_source_generation[shader_index] ||
+			p->isaac_coloroffset_link_fragment_id != p->fshader->id ||
+			p->isaac_coloroffset_link_vertex_program != p->vshader->prog ||
+			vertex_index < 0 ||
+			!isaac_coloroffset_source_generation[vertex_index] ||
+			p->isaac_coloroffset_link_vertex_generation !=
+				isaac_coloroffset_source_generation[vertex_index] ||
+			sceGxmProgramGetParameterCount(p->fshader->prog) != 1u)
+		return GL_FALSE;
+	texture0 = sceGxmProgramFindParameterByName(p->fshader->prog, "Texture0");
+	return texture0 &&
+		sceGxmProgramParameterGetCategory(texture0) ==
+			SCE_GXM_PARAMETER_CATEGORY_SAMPLER &&
+		sceGxmProgramParameterGetResourceIndex(texture0) == 0u &&
+		sceGxmProgramParameterGetArraySize(texture0) == 1u;
+}
+
+static void isaac_coloroffset_record_link(program *p) {
+	int32_t index = p ? isaac_coloroffset_shader_index(p->fshader) : -1;
+	int32_t vertex_index = p ?
+		isaac_coloroffset_shader_index(p->vshader) : -1;
+	if (index >= 0 && vertex_index >= 0 && p->vshader && p->vshader->prog &&
+			isaac_coloroffset_source_generation[vertex_index] &&
+			isaac_coloroffset_fragment_shader_is_exact(p->fshader) &&
+			isaac_coloroffset_vertex_shader_is_exact(p->vshader) &&
+			isaac_coloroffset_source_exact[index] &&
+			isaac_coloroffset_compile_exact[index] &&
+			isaac_coloroffset_source_generation[index] &&
+			isaac_coloroffset_compiled_generation[index] ==
+				isaac_coloroffset_source_generation[index]) {
+		p->isaac_coloroffset_link_fragment_id = p->fshader->id;
+		p->isaac_coloroffset_link_vertex_program = p->vshader->prog;
+		p->isaac_coloroffset_link_source_generation =
+			isaac_coloroffset_source_generation[index];
+		p->isaac_coloroffset_link_vertex_generation =
+			isaac_coloroffset_source_generation[vertex_index];
+		p->isaac_coloroffset_link_vertex_exact = 1;
+	} else if (p) {
+		p->isaac_coloroffset_link_fragment_id = 0;
+		p->isaac_coloroffset_link_vertex_program = NULL;
+		p->isaac_coloroffset_link_source_generation = 0;
+		p->isaac_coloroffset_link_vertex_generation = 0;
+		p->isaac_coloroffset_link_vertex_exact = 0;
+	}
+}
+
+static void isaac_coloroffset_note_failure(enum isaac_coloroffset_failure reason) {
+	switch (reason) {
+	case ISAAC_COLOROFFSET_FAIL_PROGRAM:
+		ISAAC_COLOROFFSET_COUNT(fail_program);
+		break;
+	case ISAAC_COLOROFFSET_FAIL_BLEND:
+		ISAAC_COLOROFFSET_COUNT(fail_blend);
+		break;
+	case ISAAC_COLOROFFSET_FAIL_SAMPLER:
+		ISAAC_COLOROFFSET_COUNT(fail_sampler);
+		break;
+	case ISAAC_COLOROFFSET_FAIL_LAYOUT:
+		ISAAC_COLOROFFSET_COUNT(fail_layout);
+		break;
+	case ISAAC_COLOROFFSET_FAIL_VERTEX_RANGE:
+		ISAAC_COLOROFFSET_COUNT(fail_vertex_range);
+		break;
+	case ISAAC_COLOROFFSET_FAIL_VERTEX_VALUE:
+		ISAAC_COLOROFFSET_COUNT(fail_vertex_value);
+		break;
+	case ISAAC_COLOROFFSET_FAIL_OUTPUT:
+		ISAAC_COLOROFFSET_COUNT(fail_output);
+		break;
+	case ISAAC_COLOROFFSET_FAIL_CACHE:
+		ISAAC_COLOROFFSET_COUNT(fail_cache);
+		break;
+	default:
+		break;
+	}
+}
+
+static GLboolean isaac_coloroffset_blend_is_exact(void) {
+	return blend_state &&
+		blend_info.info.colorMask == SCE_GXM_COLOR_MASK_ALL &&
+		blend_info.info.colorFunc == SCE_GXM_BLEND_FUNC_ADD &&
+		blend_info.info.alphaFunc == SCE_GXM_BLEND_FUNC_ADD &&
+		/* Physical raw 0x5151110f uses ONE here.  With the separately
+		 * proven source alpha of one, ONE and SRC_ALPHA are identical. */
+		(blend_info.info.colorSrc == SCE_GXM_BLEND_FACTOR_ONE ||
+		 blend_info.info.colorSrc == SCE_GXM_BLEND_FACTOR_SRC_ALPHA) &&
+		blend_info.info.colorDst ==
+			SCE_GXM_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA &&
+		(blend_info.info.alphaSrc == SCE_GXM_BLEND_FACTOR_ONE ||
+		 blend_info.info.alphaSrc == SCE_GXM_BLEND_FACTOR_SRC_ALPHA) &&
+		blend_info.info.alphaDst ==
+			SCE_GXM_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
+}
+
+static SceGxmFragmentProgram *isaac_coloroffset_find_or_create_fragment(
+		program *p, const isaac_coloroffset_cache_key *key) {
+	isaac_coloroffset_fragment_cache_entry *entry =
+		p->isaac_coloroffset_fragment_cache;
+	SceGxmBlendInfo opaque;
+	int result;
+	while (entry) {
+		if (isaac_coloroffset_cache_key_equal(&entry->key, key)) {
+			ISAAC_COLOROFFSET_COUNT(cache_hits);
+			return entry->fragment_program;
+		}
+		entry = entry->next;
+	}
+	if (p->isaac_coloroffset_fragment_cache_count >=
+			ISAAC_COLOROFFSET_FRAGMENT_CACHE_CAPACITY)
+		return NULL;
+	entry = vglMalloc(sizeof(*entry));
+	if (!entry)
+		return NULL;
+	opaque = blend_info.info;
+	opaque.colorFunc = SCE_GXM_BLEND_FUNC_NONE;
+	opaque.alphaFunc = SCE_GXM_BLEND_FUNC_NONE;
+	opaque.colorSrc = SCE_GXM_BLEND_FACTOR_ONE;
+	opaque.colorDst = SCE_GXM_BLEND_FACTOR_ZERO;
+	opaque.alphaSrc = SCE_GXM_BLEND_FACTOR_ONE;
+	opaque.alphaDst = SCE_GXM_BLEND_FACTOR_ZERO;
+	result = sceGxmShaderPatcherCreateFragmentProgram(
+		gxm_shader_patcher, p->fshader->id,
+		(SceGxmOutputRegisterFormat)key->output_format,
+		(SceGxmMultisampleMode)key->multisample_mode, &opaque,
+		p->vshader->prog, &entry->fragment_program);
+	if (result) {
+		vgl_free(entry);
+		return NULL;
+	}
+	entry->key = *key;
+	entry->next = p->isaac_coloroffset_fragment_cache;
+	p->isaac_coloroffset_fragment_cache = entry;
+	p->isaac_coloroffset_fragment_cache_count++;
+	ISAAC_COLOROFFSET_COUNT(cache_creates);
+	return entry->fragment_program;
+}
+
+static void isaac_coloroffset_release_fragment_cache(program *p) {
+	isaac_coloroffset_fragment_cache_entry *entry =
+		p->isaac_coloroffset_fragment_cache;
+	while (entry) {
+		isaac_coloroffset_fragment_cache_entry *next = entry->next;
+		sceGxmShaderPatcherReleaseFragmentProgram(
+			gxm_shader_patcher, entry->fragment_program);
+		ISAAC_COLOROFFSET_COUNT(cache_releases);
+		vgl_free(entry);
+		entry = next;
+	}
+	p->isaac_coloroffset_fragment_cache = NULL;
+	p->isaac_coloroffset_fragment_cache_count = 0;
+}
+
+static SceGxmFragmentProgram *isaac_coloroffset_select_opaque_fragment(
+		program *p, texture *tex, const SceGxmVertexAttribute *attributes,
+		const SceGxmVertexStream *streams, const void *vertices,
+		uint32_t vertex_bytes, const void *indices, uint32_t index_bytes,
+		GLboolean single_stream, GLboolean staged,
+		GLsizei count, uint32_t top_idx, uint32_t base_idx,
+		SceGxmIndexSource index_type) {
+	isaac_coloroffset_attribute_key
+		attribute_keys[ISAAC_COLOROFFSET_ATTRIBUTE_COUNT];
+	uint16_t strides[ISAAC_COLOROFFSET_ATTRIBUTE_COUNT];
+	isaac_coloroffset_cache_key key;
+	SceGxmTextureFormat descriptor_format;
+	uint32_t width, height, index;
+	SceGxmFragmentProgram *fragment;
+
+	if (!isaac_coloroffset_fragment_program_is_exact(p))
+		return NULL;
+	ISAAC_COLOROFFSET_COUNT(exact_draw_requests);
+	if (!p->isaac_coloroffset_link_vertex_exact ||
+			p->attr_num != ISAAC_COLOROFFSET_ATTRIBUTE_COUNT ||
+			p->max_frag_texunit_idx != 1u || p->max_vert_texunit_idx != 0u ||
+			!p->frag_texunits[0] ||
+			p->frag_texunits[0]->type != UNIFORM_SAMPLER) {
+		isaac_coloroffset_note_failure(ISAAC_COLOROFFSET_FAIL_PROGRAM);
+		return NULL;
+	}
+	if (!isaac_coloroffset_blend_is_exact()) {
+		isaac_coloroffset_note_failure(ISAAC_COLOROFFSET_FAIL_BLEND);
+		return NULL;
+	}
+	if (!tex || tex->status != TEX_VALID || !tex->data ||
+			tex->format != SCE_GXM_TEXTURE_FORMAT_U8U8U8_BGR) {
+		isaac_coloroffset_note_failure(ISAAC_COLOROFFSET_FAIL_SAMPLER);
+		return NULL;
+	}
+	descriptor_format = vglGetTexFormat(&tex->gxm_tex);
+	vglGetTexSizes(&tex->gxm_tex, &width, &height);
+	if (descriptor_format != SCE_GXM_TEXTURE_FORMAT_U8U8U8_BGR ||
+			width != ISAAC_COLOROFFSET_TEXTURE_WIDTH ||
+			height != ISAAC_COLOROFFSET_TEXTURE_HEIGHT) {
+		isaac_coloroffset_note_failure(ISAAC_COLOROFFSET_FAIL_SAMPLER);
+		return NULL;
+	}
+	if (!single_stream || !attributes || !streams) {
+		isaac_coloroffset_note_failure(ISAAC_COLOROFFSET_FAIL_LAYOUT);
+		return NULL;
+	}
+	for (index = 0; index < ISAAC_COLOROFFSET_ATTRIBUTE_COUNT; ++index) {
+		attribute_keys[index].stream_index = attributes[index].streamIndex;
+		attribute_keys[index].offset = attributes[index].offset;
+		attribute_keys[index].format = attributes[index].format;
+		attribute_keys[index].component_count = attributes[index].componentCount;
+		attribute_keys[index].reg_index = attributes[index].regIndex;
+		strides[index] = streams[index].stride;
+		if (p->attr_map[index] != index) {
+			isaac_coloroffset_note_failure(ISAAC_COLOROFFSET_FAIL_LAYOUT);
+			return NULL;
+		}
+	}
+	if (!isaac_coloroffset_layout_is_exact(
+			attribute_keys, strides, p->attr_num,
+			cur_vao->vertex_attrib_state, SCE_GXM_ATTRIBUTE_FORMAT_F32)) {
+		isaac_coloroffset_note_failure(ISAAC_COLOROFFSET_FAIL_LAYOUT);
+		return NULL;
+	}
+	if (!staged || count != ISAAC_COLOROFFSET_INDEX_COUNT ||
+			top_idx != ISAAC_COLOROFFSET_VERTEX_COUNT || base_idx != 0u ||
+			index_type != SCE_GXM_INDEX_SOURCE_INDEX_16BIT ||
+			vertex_bytes != ISAAC_COLOROFFSET_VERTEX_COUNT *
+				ISAAC_COLOROFFSET_VERTEX_STRIDE) {
+		isaac_coloroffset_note_failure(ISAAC_COLOROFFSET_FAIL_VERTEX_RANGE);
+		return NULL;
+	}
+	if (!isaac_coloroffset_contiguous_vertices_are_opaque(
+			vertices, vertex_bytes, top_idx,
+			ISAAC_COLOROFFSET_VERTEX_STRIDE)) {
+		isaac_coloroffset_note_failure(ISAAC_COLOROFFSET_FAIL_VERTEX_VALUE);
+		return NULL;
+	}
+	if (!isaac_coloroffset_indexed_vertices_are_opaque(
+			vertices, vertex_bytes, ISAAC_COLOROFFSET_VERTEX_STRIDE,
+			indices, index_bytes, (uint32_t)count, sizeof(uint16_t),
+			base_idx)) {
+		isaac_coloroffset_note_failure(ISAAC_COLOROFFSET_FAIL_VERTEX_RANGE);
+		return NULL;
+	}
+	if (is_fbo_float || gl_viewport.x != 0 || gl_viewport.y != 0 ||
+			gl_viewport.w != ISAAC_COLOROFFSET_VIEWPORT_WIDTH ||
+			gl_viewport.h != ISAAC_COLOROFFSET_VIEWPORT_HEIGHT) {
+		isaac_coloroffset_note_failure(ISAAC_COLOROFFSET_FAIL_OUTPUT);
+		return NULL;
+	}
+
+	key.fragment_shader_id = p->fshader->id;
+	key.source_generation =
+		isaac_coloroffset_source_generation[
+			isaac_coloroffset_shader_index(p->fshader)];
+	key.vertex_program = (uintptr_t)p->vshader->prog;
+	key.source_blend_raw = blend_info.raw;
+	key.output_format = SCE_GXM_OUTPUT_REGISTER_FORMAT_UCHAR4;
+	key.multisample_mode = msaa_mode;
+	key.texture_format = descriptor_format;
+	key.texture_width = (uint16_t)width;
+	key.texture_height = (uint16_t)height;
+	key.viewport_x = (int16_t)gl_viewport.x;
+	key.viewport_y = (int16_t)gl_viewport.y;
+	key.viewport_width = (uint16_t)gl_viewport.w;
+	key.viewport_height = (uint16_t)gl_viewport.h;
+	ISAAC_COLOROFFSET_COUNT(opaque_eligible);
+	fragment = isaac_coloroffset_find_or_create_fragment(p, &key);
+	if (!fragment) {
