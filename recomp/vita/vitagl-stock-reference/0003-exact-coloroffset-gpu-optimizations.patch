+#ifdef HAVE_ISAAC_COLOROFFSET_GPU_OPTIMIZATIONS
+struct isaac_coloroffset_fragment_cache_entry {
+	isaac_coloroffset_fragment_cache_entry *next;
+	isaac_coloroffset_cache_key key;
